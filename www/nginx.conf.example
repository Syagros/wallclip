# nginx config example for the wallclip web page.
# No JavaScript anywhere: both pages are static HTML processed by nginx SSI.
# The landing grid is nginx's own directory scan of the gallery (autoindex),
# the search results come from the wallclip unix socket, and sub_filter
# rebuilds both as bare <img loading="lazy"> tags laid out by CSS grid.
# The theme picker works without client-side JavaScript: ?theme= (via a
# map) sets a wc_theme cookie, and SSI echoes it into <body data-theme>.
#
# No njs setup needed.

# The picker submits nothing but ?theme=, so the literal $args strings are
# exact matches: "theme=" means Default was picked, "theme=<slug>" a theme.
# A search query (q=...) matches neither and leaves the cookie untouched —
# keying on "$is_args$arg_theme" instead would see "?" for ANY argument
# list and clear the cookie on every /search?q= refresh.
map $args $wc_theme_cookie {
    default              "";
    "theme="             "wc_theme=; Path=/; Max-Age=0";
    "theme=default-light"     "wc_theme=default-light; Path=/; Max-Age=31536000; SameSite=Lax";
    "theme=gruvbox"           "wc_theme=gruvbox; Path=/; Max-Age=31536000; SameSite=Lax";
    "theme=gruvbox-light"     "wc_theme=gruvbox-light; Path=/; Max-Age=31536000; SameSite=Lax";
    "theme=catppuccin"        "wc_theme=catppuccin; Path=/; Max-Age=31536000; SameSite=Lax";
    "theme=tokyonight"        "wc_theme=tokyonight; Path=/; Max-Age=31536000; SameSite=Lax";
}

server {
    listen 127.0.0.1:8080;
    # listen 443 ssl;  # add tls + server_name for a real host

    root /home/oc/Projects/wallclip/www;

    ssi on;
    add_header Set-Cookie $wc_theme_cookie; # empty map value: no header

    location = / {
        try_files /index.html =404;
    }

    location = /search {
        try_files /search.html =404;
    }

    # landing grid: a directory scan of the gallery root (depth 1), with
    # every <a href="name"> rewritten into a thumbnail img that still sits
    # inside its link: the link targets /files/ (the original) and opens a
    # new tab, the autoindex text (name/date/size) is hidden with <span>
    location /_home/ {
        internal;
        alias /mnt/HDD/Wallpapers-Flat/;
        autoindex on;

        sub_filter_types *;
        sub_filter_once off;
        # drop the autoindex "../" parent row outright (it would otherwise
        # surface as a grid tile); must come before the '<a href="' rule
        sub_filter '<pre><a href="../">../</a>\r\n' '<pre>';
        sub_filter '<a href="' '<a target="_blank" rel="noopener" href="/files/';
        sub_filter '">'        '"><img loading="lazy" src="/files/.thumbnails/';
        sub_filter '</a>'      '"></a><span hidden>';
        sub_filter '\r\n'      '</span>\r\n';
    }

    # search results: internal proxy for the socket, which answers
    # GET /<query> with newline-separated absolute thumbnail paths
    # ("/mnt/HDD/Wallpapers-Flat/.thumbnails/name"). sub_filter turns the
    # list into one HTML fragment of <img> tags: every "\n<root>" becomes
    # the end of one img tag plus the start of the next, the first line's
    # root is rewritten by itself, and the trailing newline is dropped. The
    # page wraps the fragment in one more <img ... src=" pair.
    location /_q/ {
        internal;
        rewrite ^/_q/(.*)$ /$1 break;
        proxy_pass http://unix:/run/wallclip/socket:/;
        proxy_set_header Accept-Encoding "";

        sub_filter_types *;
        sub_filter_once off;
        sub_filter '\n/mnt/HDD/Wallpapers-Flat/' '"><img loading="lazy" src="/files/';
        sub_filter '/mnt/HDD/Wallpapers-Flat/' '/files/';
        # known quirk: nginx's sub module flushes the final bytes of a
        # proxied body without substituting, so the last line's trailing
        # newline stays inside the last src="..." attribute. Browsers strip
        # ASCII whitespace when resolving the URL, so the image loads.
    }

    # serves both thumbnails (.../.thumbnails/name) and originals;
    # body URLs point into /files/, which is rooted at the gallery root
    location /files/ {
        alias /mnt/HDD/Wallpapers-Flat/;
        # adjust to wherever the gallery's images live
    }
}
