# Copy to .env and chmod 600. Real environment variables take precedence.
# The file is read from the current directory unless WALLCLIP_ENV_FILE
# (shell environment only) points somewhere else.

# PostgreSQL credentials (unset values fall back to libpq defaults/PG* vars)
WALLCLIP_DB_NAME=wallclip
WALLCLIP_DB_USER=wallclip
WALLCLIP_DB_PASSWORD=
# WALLCLIP_DB_HOST=/var/run/postgresql
# WALLCLIP_DB_PORT=5432

# Optional settings, defaults live in wallclip.h
# WALLCLIP_SOCKET_PATH=/run/wallclip/socket
# WALLCLIP_MODEL_PATH=/usr/local/src/clip.cpp/models/clip-vit-base-patch32_ggml-model-f32.gguf
# WALLCLIP_SIMILARITY_THRESHOLD=0.27
# WALLCLIP_MAX_MATCHES=100
# WALLCLIP_VERBOSITY=0
